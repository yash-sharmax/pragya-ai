# ============================================================
#  Pragya AI — Environment Variables (EXAMPLE)
# ============================================================
#  HOW TO USE:
#  1. Copy this file and rename the copy to ".env.local"
#  2. Fill in your own values (see where to get each key below)
#  3. Never commit your real ".env.local" file to GitHub.
# ============================================================


# ------------------------------------------------------------
# 1) SUPABASE  (login, user accounts and database)
#    Get these from: https://supabase.com  →  your project
#    →  Project Settings  →  API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Older Supabase projects call the same key "anon key".
# Fill EITHER the publishable key above OR this one:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key


# ------------------------------------------------------------
# 2) DATABASE CONNECTION  (only needed to run DB migrations
#    with:  npm run db:migrate )
#    Supabase → Project Settings → Database → Connection string
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your-password@your-host:5432/postgres


# ------------------------------------------------------------
# 3) GOOGLE GEMINI  (powers Pragya Veda, Neeti and Sarathi)
#    Get a free key from: https://aistudio.google.com/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Optional — leave empty to use the built-in default model chain:
# GEMINI_MODEL=


# ------------------------------------------------------------
# 4) GROQ  (powers Pragya Ganita — the mathematics persona)
#    Get a free key from: https://console.groq.com/keys
# ------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
# Optional — leave empty to use the built-in default model:
# GROQ_MODEL=


# ------------------------------------------------------------
# 5) OPTIONAL: LIVE WEB SEARCH  (extra source grounding)
#    Only used when SEARCH_PROVIDER is "tavily".
#    Get a key from: https://tavily.com
# ------------------------------------------------------------
SEARCH_API_KEY=
SEARCH_PROVIDER=
